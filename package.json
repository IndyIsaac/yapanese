{
  "name": "yapanese",
  "productName": "Yapanese",
  "version": "0.2.0",
  "description": "Local dictation for Windows. Hold a key, talk, and the text lands where your cursor is.",
  "main": "src/main/main.js",
  "author": "Indy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "dev.yapanese.app",
    "productName": "Yapanese",
    "copyright": "Copyright (c) 2026 Indy",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "node_modules/@fontsource/inter/files/inter-latin-400-normal.woff2",
      "node_modules/@fontsource/inter/files/inter-latin-500-normal.woff2",
      "node_modules/@fontsource/inter/files/inter-latin-600-normal.woff2",
      "node_modules/@fontsource/inter/LICENSE",
      "node_modules/uiohook-napi/**/*",
      "LICENSE",
      "THIRD-PARTY.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "Yapanese-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yapanese",
      "uninstallDisplayName": "Yapanese"
    }
  }
}
